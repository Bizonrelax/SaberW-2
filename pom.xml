<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.saberw</groupId>
  <artifactId>SaberW-2</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>SaberW-2</name>
  <description>Desktop app for bidirectional text compression for LLM chats (MVP core).</description>

  <properties>
    <!-- ТЗ (п.1): Java 21+. Разрешено использовать Virtual Threads. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.3</junit.version>
  </properties>

  <dependencies>
    <!-- Jackson Databind -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      
      <!-- Создание исполняемого JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.saberw.gui.MainWindow</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Упаковка в EXE (Launch4j). Официальный релизный артефакт в Maven Central:
           com.akathist.maven.plugins.launch4j (репозиторий orphan-oss/launch4j-maven-plugin).
           Старый com.akiban:launch4j-maven-plugin:2.5.1 отсутствует в Central — из-за него
           сборка в GitHub Actions падала. -->
      <plugin>
        <groupId>com.akathist.maven.plugins.launch4j</groupId>
        <artifactId>launch4j-maven-plugin</artifactId>
        <version>2.6.0</version>
        <executions>
          <execution>
            <id>l4j-clui</id>
            <phase>package</phase>
            <goals>
              <goal>launch4j</goal>
            </goals>
            <configuration>
              <headerType>gui</headerType>
              <outfile>target/SaberW-2.exe</outfile>
              <jar>target/${project.build.finalName}.jar</jar>
              <errTitle>SaberW-2 Error</errTitle>
              <classPath>
                <mainClass>com.saberw.gui.MainWindow</mainClass>
                <addDependencies>true</addDependencies>
              </classPath>
              <jre>
                <minVersion>21</minVersion>
                <path>jre</path> <!-- Launch4j будет искать портативную JRE в локальной папке jre рядом с EXE -->
              </jre>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
